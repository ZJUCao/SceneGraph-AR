# Coding style shared by editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp}]
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake,*.json}]
indent_style = space
indent_size = 4

[*.{sh,command}]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
